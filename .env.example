# Recommended. One Groq key powers Whisper transcription and coaching.
GROQ_API_KEY=

# Recommended for natural Indian English, Hindi, and Telugu speech.
SARVAM_API_KEY=

# Optional fallback if you prefer OpenAI instead.
OPENAI_API_KEY=

# Optional model overrides
# Leave these blank to use provider defaults.
GROQ_COACH_MODEL=
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3
GROQ_SPEECH_MODEL=canopylabs/orpheus-v1-english
GROQ_SPEECH_VOICE=daniel
SARVAM_SPEECH_MODEL=bulbul:v3
COACH_MODEL=
TRANSCRIPTION_MODEL=

# App server
PORT=8787
